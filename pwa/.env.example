# ─── Configuration BarPro PWA — Supabase ───────────────────────────────────────
# Copiez ce fichier en .env.local et remplissez avec vos identifiants Supabase.
# Les variables préfixées par VITE_ sont exposées côté client via import.meta.env.
#
# Pour récupérer vos identifiants :
#   1. Allez sur https://supabase.com/dashboard
#   2. Sélectionnez votre projet BarPro
#   3. Settings → API → Project URL + anon/public key
#
# Une fois rempli, rebuild :
#   cd /workspaces/barpro/pwa
#   npm run build
#   npm run preview
#
# Sans ces variables, l'application fonctionne en mode local (Dexie/IndexedDB).

VITE_SUPABASE_URL=sb_publishable_t6qkAX6fw6hAhpgaKTD0xg_lp2XVWZ3
VITE_SUPABASE_ANON_KEY=your_anon_key_here
