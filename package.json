{
  "name": "barpro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["core", "pwa", "console"],
  "scripts": {
    "dev": "concurrently \"npm run dev:pwa\" \"npm run dev:console\"",
    "dev:pwa": "npm run dev --workspace=pwa",
    "dev:console": "npm run dev --workspace=console",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

